{
  "$defs": {
    "OperationFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_data",
            "unsupported_configuration",
            "incompatible_artifact",
            "capacity_limit",
            "source_failure",
            "infrastructure_failure",
            "attempts_exhausted"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "OperationFailure",
      "type": "object"
    },
    "ResolvedModel": {
      "additionalProperties": false,
      "description": "Capture the concrete deployment at intake, before publication can change it.",
      "properties": {
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "inference_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Inference Policy Sha256",
          "type": "string"
        },
        "model_version_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Version Id",
          "type": "string"
        }
      },
      "required": [
        "model_version_id",
        "bundle_sha256",
        "inference_policy_sha256"
      ],
      "title": "ResolvedModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "attempt_token": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Token"
    },
    "attempt_tokens": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Attempt Tokens",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "heartbeat_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Heartbeat At"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "kind": {
      "enum": [
        "generation",
        "training",
        "evaluation",
        "analysis",
        "reference",
        "publication"
      ],
      "title": "Kind",
      "type": "string"
    },
    "max_attempts": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResolvedModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_id": {
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "resource_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Resource Id",
      "type": "string"
    },
    "result_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Sha256"
    },
    "stage": {
      "default": "queued",
      "maxLength": 128,
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "state": {
      "default": "queued",
      "enum": [
        "queued",
        "running",
        "cancel_requested",
        "cancelled",
        "succeeded",
        "failed"
      ],
      "title": "State",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "const": "1.2",
      "default": "1.2",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "owner_id",
    "kind",
    "resource_id",
    "request_sha256",
    "idempotency_key",
    "created_at",
    "updated_at"
  ],
  "title": "Operation",
  "type": "object"
}
